# En local, le frontend appelle /api/v1.
# Vite redirige automatiquement /api vers le backend ci-dessous.
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_PROXY_TARGET=http://localhost:8000

# Google Identity Services
# Utiliser le même OAuth 2.0 Client ID Web que GOOGLE_CLIENT_ID côté backend.
VITE_GOOGLE_CLIENT_ID=
