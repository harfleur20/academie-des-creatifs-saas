# Relais vidéo supplémentaire. Copiez en .env dans ce dossier, sur le serveur du relais.
# Même version que le serveur principal (JITSI_RELEASE de install-main.sh).
JITSI_IMAGE_VERSION=stable-11248-3
TZ=Africa/Douala

# Serveur principal, joint par le réseau privé (XMPP_PRIVATE_IP de main.env).
XMPP_SERVER=10.0.0.2
XMPP_PORT=5222
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
JVB_AUTH_USER=jvb
# Même valeur que JVB_AUTH_PASSWORD dans le .env du serveur principal.
JVB_AUTH_PASSWORD=change-me
JVB_BREWERY_MUC=jvbbrewery

# IP publique de ce relais, annoncée aux participants pour la vidéo (UDP 10000).
JVB_PORT=10000
JVB_ADVERTISE_IPS=203.0.113.11
