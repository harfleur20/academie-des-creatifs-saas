# Réglages du serveur principal du live (web, Prosody, Jicofo et un premier relais vidéo).
# Copiez ce fichier en main.env, remplissez-le, puis lancez install-main.sh.
# Ces valeurs remplacent celles du .env officiel de docker-jitsi-meet ; ses mots de passe
# internes sont générés par gen-passwords.sh et ne doivent pas figurer ici.

# Serveur géré par Coolify : mettez 1. Son proxy garde les ports 80/443 et le certificat ;
# Jitsi n'écoute alors qu'en local et le script ajoute la route du domaine dans Coolify.
# Les lignes HTTP_PORT à LETSENCRYPT_EMAIL ci-dessous sont alors ignorées.
BEHIND_COOLIFY=0

# Adresse publique du live (enregistrement DNS A vers ce serveur).
PUBLIC_URL=https://live.example.com
HTTP_PORT=80
HTTPS_PORT=443
ENABLE_HTTP_REDIRECT=1
ENABLE_LETSENCRYPT=1
LETSENCRYPT_DOMAIN=live.example.com
LETSENCRYPT_EMAIL=admin@example.com
TZ=Africa/Douala

# IP publique de ce serveur, annoncée aux participants pour la vidéo (UDP 10000).
JVB_ADVERTISE_IPS=203.0.113.10

# Seuls les jetons signés par le SaaS ouvrent une salle.
ENABLE_AUTH=1
AUTH_TYPE=jwt
JWT_APP_ID=academie-live
# Générez-le avec : openssl rand -hex 32. Même valeur que JITSI_APP_SECRET dans backend/.env.
JWT_APP_SECRET=change-me
JWT_ACCEPTED_ISSUERS=academie-live
JWT_ACCEPTED_AUDIENCES=academie-live
JWT_ALLOW_EMPTY=0
ENABLE_GUESTS=0

# Le rôle de modérateur vient du jeton (professeur de la séance, équipe de l'école),
# jamais de l'ordre d'arrivée. Le module est copié par install-main.sh.
XMPP_MUC_MODULES=token_affiliation
ENABLE_AUTO_OWNER=0

# Relais vidéo supplémentaires (au-delà d'une dizaine de classes simultanées) :
# décommentez avec l'IP privée de ce serveur ; Prosody n'écoutera le port 5222 que sur elle.
#XMPP_PRIVATE_IP=10.0.0.2

ENABLE_PREJOIN_PAGE=1
ENABLE_WELCOME_PAGE=0
ENABLE_RECORDING=0
DEFAULT_LANGUAGE=fr
