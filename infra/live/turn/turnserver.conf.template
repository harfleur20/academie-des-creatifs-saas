# Relais TURN des classes live (coturn). install-main.sh génère turnserver.conf à partir de ce
# modèle : modifiez le modèle, pas le fichier généré.
# Les participants l'atteignent en TCP sur 3478, ou en TLS sur 443 quand le proxy de Coolify
# déchiffre la connexion et la lui transmet. Pas de TURN en UDP : Jitsi ne s'en sert pas pour
# joindre le relais vidéo.
listening-port=3478
no-udp
no-tls
realm=__TURN_DOMAIN__
external-ip=__PUBLIC_IP__
min-port=49160
max-port=49359

# Accès temporaires que Prosody signe avec ce secret (TURN_CREDENTIALS du .env de Jitsi).
use-auth-secret
static-auth-secret=__TURN_SECRET__
fingerprint
stale-nonce=600

# Le relais ne sert qu'à joindre les relais vidéo, par leur IP publique : jamais le réseau
# privé ni les conteneurs du serveur (base de données, Coolify).
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

no-software-attribute
log-file=stdout
simple-log
