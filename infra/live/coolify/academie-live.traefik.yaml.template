# Routes du live dans le proxy Traefik de Coolify (configuration dynamique).
# install-main.sh remplace __DOMAIN__ et __TURN_DOMAIN__, puis copie ce fichier dans /data/coolify/proxy/dynamic/.
http:
  routers:
    academie-live-http:
      rule: Host(`__DOMAIN__`)
      entryPoints:
        - http
      middlewares:
        - academie-live-https
      service: academie-live
    academie-live:
      rule: Host(`__DOMAIN__`)
      entryPoints:
        - https
      service: academie-live
      tls:
        certResolver: letsencrypt
  middlewares:
    academie-live-https:
      redirectScheme:
        scheme: https
        permanent: true
  services:
    academie-live:
      loadBalancer:
        servers:
          - url: http://academie-live-web:8000

# Relais TURN en TLS sur 443 : Traefik déchiffre la connexion du domaine TURN et la transmet en TCP
# à coturn, qui écoute sur le port 3478 de l'hôte (réseau de l'hôte).
tcp:
  routers:
    academie-turn:
      rule: HostSNI(`__TURN_DOMAIN__`)
      entryPoints:
        - https
      service: academie-turn
      tls:
        certResolver: letsencrypt
  services:
    academie-turn:
      loadBalancer:
        servers:
          - address: host.docker.internal:3478
