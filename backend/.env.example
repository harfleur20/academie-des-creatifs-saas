APP_ENV=development
# PostgreSQL recommandé (stack cible)
DATABASE_URL=postgresql+psycopg://academie_saas:change-me@localhost:5432/academie_saas
# Alternative rapide sans PostgreSQL pour un test local :
# DATABASE_URL=sqlite:///./academie_saas.db
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=academie-des-creatifs-saas

# Google Identity Services
# Même OAuth 2.0 Client ID Web que VITE_GOOGLE_CLIENT_ID côté frontend.
GOOGLE_CLIENT_ID=

# Paiement
# production = TaraMoney réel ; demo = simulation locale.
PAYMENT_MODE=demo
ALLOW_DEMO_PAYMENTS=true
DEMO_PAYMENT_AMOUNT_CENTS=100

# TaraMoney réel
TARAMONEY_API_BASE_URL=https://www.dklo.co
TARAMONEY_CREATE_PAYMENT_PATH=/api/tara/paymentlinks
TARAMONEY_VERIFY_PAYMENT_PATH=/api/tara/transactions/status
TARAMONEY_API_KEY=
TARAMONEY_BUSINESS_ID=
TARAMONEY_WEBHOOK_SECRET=
# Optionnel : si Tara envoie le secret partagé dans un header personnalisé.
TARAMONEY_WEBHOOK_SECRET_HEADER=
TARAMONEY_PRODUCT_PICTURE_URL=
TARAMONEY_TIMEOUT_SECONDS=8


# Cycle d'abonnement
BILLING_GRACE_PERIOD_DAYS=7
# Secret utilisé par le cron qui applique les expirations/past_due/suspensions.
BILLING_CRON_SECRET=replace-with-a-long-random-secret


# White-label / domaines
# Ex: schools.example.com
SAAS_BASE_DOMAIN=
# Cible CNAME à communiquer pour les domaines personnalisés.
SAAS_CNAME_TARGET=


# Identité de l'école
# Un propriétaire ne peut renommer son école qu'une fois pendant cette période.
ORGANIZATION_NAME_CHANGE_COOLDOWN_DAYS=30


# Stockage pédagogique
# local uniquement en développement ; utiliser r2 en production.
STORAGE_PROVIDER=local
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=


# Communications white-label
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_TIMEOUT_SECONDS=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Académie des Créatifs
# Boîte qui reçoit les demandes envoyées depuis la page Support.
# Si vide, le backend utilise SMTP_FROM comme destinataire.
SUPPORT_EMAIL=

WAPINO_ENABLED=false
WAPINO_BASE_URL=https://api.wapino.consolidis.com
WAPINO_API_KEY=
WAPINO_INSTANCE=AcademieCreatifs
WAPINO_TEXT_ENDPOINT=/message/send-text
WAPINO_TIMEOUT_SECONDS=15

# Paiements étudiants
COMMERCE_GRACE_PERIOD_DAYS=7
COMMERCE_RESERVATION_MINUTES=30
