APP_ENV=development
# PostgreSQL recommandé (stack cible)
DATABASE_URL=postgresql+psycopg://academie_saas:change-me@localhost:5432/academie_saas
# Alternative rapide sans PostgreSQL pour un test local :
# DATABASE_URL=sqlite:///./academie_saas.db
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=academie-des-creatifs-saas

# Chiffrement des secrets d'intégrations propres aux écoles (OpenAI, etc.).
# Générer une clé Fernet dédiée en production et ne jamais la changer sans rotation des secrets stockés.
INTEGRATION_ENCRYPTION_KEY=

# Session navigateur partagée entre les onglets.
AUTH_COOKIE_NAME=academie_saas_session
# En production, mettre le domaine parent pour partager la connexion entre les sous-domaines.
# Exemple : .academiecreatif.com
AUTH_COOKIE_DOMAIN=
# false uniquement en développement HTTP local ; true en production HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Google Identity Services
# Même OAuth 2.0 Client ID Web que VITE_GOOGLE_CLIENT_ID côté frontend.
GOOGLE_CLIENT_ID=

# Paiement
# production = TaraMoney réel ; demo = simulation locale.
PAYMENT_MODE=demo
ALLOW_DEMO_PAYMENTS=true
DEMO_PAYMENT_AMOUNT_CENTS=100

# TaraMoney réel
TARAMONEY_API_BASE_URL=https://www.dklo.co
TARAMONEY_CREATE_PAYMENT_PATH=/api/tara/paymentlinks
TARAMONEY_VERIFY_PAYMENT_PATH=/api/tara/transactions/status
TARAMONEY_API_KEY=
TARAMONEY_BUSINESS_ID=
TARAMONEY_WEBHOOK_SECRET=
# Optionnel : si Tara envoie le secret partagé dans un header personnalisé.
TARAMONEY_WEBHOOK_SECRET_HEADER=
TARAMONEY_PRODUCT_PICTURE_URL=
TARAMONEY_TIMEOUT_SECONDS=8


# Cycle d'abonnement
BILLING_GRACE_PERIOD_DAYS=7
# Secret des tâches horaires : abonnements, paiements étudiants, rappels de devoirs.
# Même valeur que le secret GitHub BILLING_CRON_SECRET.
BILLING_CRON_SECRET=replace-with-a-long-random-secret
# Backend appelé par ces tâches (sans slash final). En production, c'est le secret GitHub
# BILLING_CRON_URL ; en local, lancer `python scripts/run_cron_jobs.py --every 15`.
BILLING_CRON_URL=http://localhost:8000


# White-label / domaines
# Ex: schools.example.com
SAAS_BASE_DOMAIN=
# Cible CNAME à communiquer pour les domaines personnalisés.
SAAS_CNAME_TARGET=


# Identité de l'école
# Un propriétaire ne peut renommer son école qu'une fois pendant cette période.
ORGANIZATION_NAME_CHANGE_COOLDOWN_DAYS=30


# Stockage pédagogique
# local uniquement en développement ; utiliser r2 en production.
STORAGE_PROVIDER=local
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Salles de cours live sécurisées JaaS (clé privée conservée côté backend)
# Fournisseur des classes live : jaas (Jitsi hébergé par 8x8) ou jitsi (auto-hébergé, voir infra/live).
LIVE_PROVIDER=jaas
JITSI_DOMAIN=
JITSI_APP_ID=academie-live
# Même valeur que JWT_APP_SECRET du serveur live (openssl rand -hex 32).
JITSI_APP_SECRET=
JITSI_XMPP_DOMAIN=meet.jitsi

JAAS_ENABLED=false
JAAS_DOMAIN=8x8.vc
JAAS_APP_ID=
JAAS_KID=
JAAS_PRIVATE_KEY_FILE=
JAAS_RECORDING_ENABLED=false
JAAS_WEBHOOK_SECRET=
# Jeton Authorization transmis par JaaS au endpoint Advanced branding.
JAAS_BRANDING_TOKEN=
LIVE_REPLAY_DOWNLOAD_ENABLED=true


# Communications white-label
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_TIMEOUT_SECONDS=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Académie des Créatifs
# Boîte qui reçoit les demandes envoyées depuis la page Support.
# Si vide, le backend utilise SMTP_FROM comme destinataire.
SUPPORT_EMAIL=

WAPINO_ENABLED=false
WAPINO_BASE_URL=https://api.wapino.consolidis.com
WAPINO_API_KEY=
WAPINO_INSTANCE=AcademieCreatifs
WAPINO_TEXT_ENDPOINT=/message/send-text
WAPINO_TIMEOUT_SECONDS=15

# Paiements étudiants
COMMERCE_GRACE_PERIOD_DAYS=7
COMMERCE_RESERVATION_MINUTES=30
