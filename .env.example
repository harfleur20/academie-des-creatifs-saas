# Public media on Cloudinary; private school files on Backblaze B2
PUBLIC_ASSET_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

STORAGE_PROVIDER=b2
B2_ENDPOINT_URL=
B2_REGION=
B2_PRIVATE_BUCKET_NAME=academie-saas-files-private
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
# Optional legacy public B2 bucket settings (leave blank for a new setup)
B2_BUCKET_NAME=
B2_PUBLIC_BASE_URL=
SAAS_RESERVED_SUBDOMAINS=coupe,ferrolink,media

# Off-server PostgreSQL backups to Backblaze B2
BACKUP_B2_ENABLED=true
BACKUP_B2_ENDPOINT_URL=
BACKUP_B2_REGION=
BACKUP_B2_BUCKET_NAME=
BACKUP_B2_ACCESS_KEY_ID=
BACKUP_B2_SECRET_ACCESS_KEY=
BACKUP_B2_PREFIX=academie-saas/postgres
